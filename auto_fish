
-- =========================================================
-- AUTO FISHING + AUTO TRASH
-- GENTA HAX
-- Struktur queue mengikuti Auto Surgery
-- DROP DIHAPUS
-- =========================================================

-- ========================
-- CONFIG
-- ========================

local REBAIT_DELAY = 1000
local INVENTORY_INTERVAL = 2000
local TRASH_DIALOG_TIMEOUT = 5000
local TRASH_RESULT_TIMEOUT = 6000
local TRASH_DIALOG_DELAY = 300

-- false = ikan di atas threshold dibiarkan
-- true  = ikan di atas threshold juga di-trash
local trashLargeFish = true

-- ========================
-- BAIT
-- ========================

local validBaits = {
    [3012] = "Shiny",
    [3014] = "Salmon Eggs",
    [3016] = "Fishing Fly",
    [3018] = "Shrimp Lure"
}

-- ========================
-- IKAN & THRESHOLD
-- ========================

local trashItems = {
    { id = 3036, name = "Sunfish",         threshold = 200 },
    { id = 3030, name = "Dogfish",         threshold = 49  },
    { id = 3032, name = "Gar",             threshold = 89  },
    { id = 3038, name = "Bass",            threshold = 69  },
    { id = 3026, name = "Catfish",         threshold = 29  },
    { id = 3000, name = "Goldfish",        threshold = 14  },
    { id = 3034, name = "Mahi Mahi",       threshold = 200 },
    { id = 5548, name = "Absol",           threshold = 59  },
    { id = 5542, name = "Double",          threshold = 59  },
    { id = 5552, name = "Cuttlefish",      threshold = 119 },
    { id = 5538, name = "Maidmare",        threshold = 159 },
    { id = 5580, name = "Weird Manta Ray", threshold = 189 },
    { id = 5574, name = "Alpha",           threshold = 189 },
    { id = 3814, name = "StoneFish",       threshold = 159 },
    { id = 3024, name = "Whale",           threshold = 199 },
    { id = 4958, name = "SandShark",       threshold = 199 }
}

-- ========================
-- STATE
-- ========================

local activeBait = nil
local baitX = nil
local baitY = nil

local scriptPlacing = false
local placeResetAt = 0

local pendingRebait = false
local itemJob = nil
local nextInventoryCheck = 0

-- ========================
-- QUEUE SYSTEM
-- ========================

local queue = { task = {} }

function queue:add(fn, delay)
    local now = getCurrentTimeInternal()
    local lastTime = now

    if #self.task > 0 then
        lastTime = math.max(now, self.task[#self.task].runAt)
    end

    table.insert(self.task, {
        fn = fn,
        runAt = lastTime + (delay or 0)
    })
end

-- ========================
-- UTILITY
-- ========================

local function nowMs()
    return getCurrentTimeInternal()
end

local function logMessage(message)
    logToConsole("`0[`9Auto Fishing`0] `w" .. tostring(message))
end

local function checkItemAmount(inventory, itemID)
    if not inventory then return 0 end

    for _, item in pairs(inventory) do
        if item.id == itemID then
            return item.amount or 0
        end
    end

    return 0
end

-- ========================
-- PLACE BAIT
-- ========================

local function placeBait()
    if not activeBait then return end
    if baitX == nil or baitY == nil then return end
    if scriptPlacing then return end

    local player = getLocal()

    if not player or not player.pos then
        logMessage("Posisi player tidak tersedia.")
        return
    end

    scriptPlacing = true
    placeResetAt = nowMs() + 500

    sendPacketRaw(false, {
        type = 3,
        value = activeBait,
        x = player.pos.x,
        y = player.pos.y,
        punchx = baitX,
        punchy = baitY
    })

    logMessage("Memasang bait: " .. validBaits[activeBait])
end

-- ========================
-- FISHING RESULT
-- ========================

local function scheduleRebait()
    if not activeBait or pendingRebait then return end

    pendingRebait = true

    queue:add(function()
        if activeBait then
            placeBait()
        end

        pendingRebait = false
    end, REBAIT_DELAY)
end

-- ========================
-- MANUAL BAIT DETECTOR
-- ========================

AddHook("OnGameUpdatePacket", "FishingPacket", function(packet)
    if not packet then return end

    if packet.type == 3 and not scriptPlacing then
        local baitID = packet.value

        if validBaits[baitID] then
            activeBait = baitID
            baitX = packet.punchx
            baitY = packet.punchy

            pendingRebait = false

            logMessage(
                "Bait aktif: " .. validBaits[baitID]
                .. " | Target: " .. tostring(baitX)
                .. ", " .. tostring(baitY)
            )
        end
    end
end)

-- ========================
-- TRASH JOB
-- Satu item sampai terkonfirmasi
-- ========================

local function startTrash(itemID, amount, itemName)
    if itemJob then return end
    if amount <= 0 then return end

    itemJob = {
        id = itemID,
        amount = amount,
        name = itemName,
        stage = "request_queued",
        deadline = nil
    }

    logMessage("Menjadwalkan trash: " .. itemName .. " x" .. amount)

    queue:add(function()
        if not itemJob then return end
        if itemJob.id ~= itemID then return end
        if itemJob.stage ~= "request_queued" then return end

        itemJob.stage = "waiting_dialog"
        itemJob.deadline = nowMs() + TRASH_DIALOG_TIMEOUT

        sendPacket(2, "action|trash\nitemID|" .. itemID)

        logMessage("Menunggu dialog: " .. itemName)
    end, 200)
end

-- ========================
-- VARLIST HOOK
-- ========================

AddHook("onvarlist", "FishingAndTrashDetector", function(var)
    if not var then return end

    local eventName = var[0] or ""
    local message = var[1] or ""

    -- HASIL MANCING
    if eventName == "OnConsoleMessage" then
        if message:find("You caught", 1, true)
        or message:find("There was nothing on the line!", 1, true) then
            scheduleRebait()
        end

        -- KONFIRMASI TRASH
        if itemJob
        and itemJob.stage == "waiting_result"
        and message:find("recycled", 1, true) then

            logMessage("Trash berhasil: " .. itemJob.name)

            itemJob = nil
            nextInventoryCheck = nowMs() + INVENTORY_INTERVAL
        end

        return
    end

    -- DIALOG TRASH
    if eventName == "OnDialogRequest" then
        if not itemJob then return end
        if itemJob.stage ~= "waiting_dialog" then return end

        local expectedDialog =
            message:find("end_dialog|trash_item", 1, true) ~= nil

        local expectedItem =
            message:find(
                "embed_data|itemID|" .. itemJob.id,
                1,
                true
            ) ~= nil

        if expectedDialog and expectedItem then
            local itemID = itemJob.id
            local amount = itemJob.amount

            -- Kunci state agar dialog yang sama tidak diproses dua kali.
            itemJob.stage = "return_queued"
            itemJob.deadline = nil

            queue:add(function()
                if not itemJob then return end
                if itemJob.id ~= itemID then return end
                if itemJob.stage ~= "return_queued" then return end

                itemJob.stage = "waiting_result"
                itemJob.deadline = nowMs() + TRASH_RESULT_TIMEOUT

                sendPacket(
                    2,
                    "action|dialog_return\n"
                    .. "dialog_name|trash_item\n"
                    .. "itemID|" .. itemID .. "\n"
                    .. "count|" .. amount
                )

                logMessage(
                    "Mengirim trash: " .. itemJob.name
                    .. " x" .. amount
                )
            end, TRASH_DIALOG_DELAY)
        end
    end
end)

-- ========================
-- INVENTORY SCANNER
-- ========================

local function scanInventory()
    if itemJob then return end
    if pendingRebait then return end
    if nowMs() < nextInventoryCheck then return end

    nextInventoryCheck = nowMs() + INVENTORY_INTERVAL

    local ok, inventory = pcall(getInventory)

    if not ok or not inventory then
        logMessage("Gagal membaca inventory.")
        return
    end

    for _, fish in ipairs(trashItems) do
        local amount = checkItemAmount(inventory, fish.id)

        if amount > 0 then
            local shouldTrash =
                amount <= fish.threshold or trashLargeFish

            if shouldTrash then
                startTrash(fish.id, amount, fish.name)
                return
            end
        end
    end
end

-- ========================
-- TIMEOUT GUARD
-- Jangan mengulang dialog otomatis
-- jika transaksi tidak selesai.
-- ========================

local function checkTrashTimeout()
    if not itemJob then return end
    if not itemJob.deadline then return end
    if nowMs() < itemJob.deadline then return end

    local stage = itemJob.stage
    local name = itemJob.name

    if stage == "waiting_dialog" then
        logMessage("Timeout dialog: " .. name)
        itemJob = nil
        nextInventoryCheck = nowMs() + 10000

    elseif stage == "waiting_result" then
        logMessage("Timeout konfirmasi: " .. name)
        itemJob = nil
        nextInventoryCheck = nowMs() + 10000
    end
end

-- ========================
-- EXECUTOR
-- ========================

AddHook("OnRender", "FishingQueueExecutor", function()
    local ok, err = pcall(function()
        local currentTime = nowMs()

        if scriptPlacing and currentTime >= placeResetAt then
            scriptPlacing = false
        end

        -- Eksekusi satu tugas queue pada satu waktu.
        if #queue.task > 0 then
            local task = queue.task[1]

            if currentTime >= task.runAt then
                table.remove(queue.task, 1)

                local success, taskError = pcall(task.fn)

                if not success then
                    logMessage("Queue error: " .. tostring(taskError))
                end
            end
        end

        checkTrashTimeout()
        scanInventory()
    end)

    if not ok then
        logMessage("Executor error: " .. tostring(err))
    end
end)

logMessage("Script aktif.")
logMessage("Trash ikan besar: " .. tostring(trashLargeFish))
logMessage("Fitur DROP dinonaktifkan.")
logMessage("Pasang bait secara manual untuk memulai.")
